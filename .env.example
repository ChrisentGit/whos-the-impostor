# Copy this file to .env at the repo root and fill in the values.
# Never commit .env.

# --- Database (Phases 0+) ---
# Local example. In production use Neon or Supabase.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/impostor_dev"

# --- Auth.js (Phase 2) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Game server (Phase 2) ---
# Shared by Next.js (signs the JWT) and the game server (verifies it).
GAME_SERVER_JWT_SECRET=""
# Render sets PORT automatically in production.
PORT="4000"
# Origin allowed to open Socket.IO connections.
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_GAME_SERVER_URL="http://localhost:4000"

# --- LiveKit (Phase 3) ---
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""
